BOT_TOKEN=
GEMINI_API_KEY=             # Google AI Studio API key
ADMIN_USER_ID=              # your Telegram user id — bot owner, auto-registered as admin
TZ=Europe/Paris
DB_URL=sqlite+aiosqlite:///data/frbot.db

# Pilot
MAX_USERS=50                # hard cap on registrations
DAILY_LLM_ACTIONS=150       # per-user daily cap on AI actions (reviews are free)

# Models
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.5-flash-lite

# Learning defaults (each participant can override via /settings)
DAILY_NEW_LIMIT=15          # max new cards introduced per day
SESSION_MAX=30              # max cards per review session
REMINDER_TIME=08:30         # daily due-count reminder
WRITING_TIME=19:00          # daily writing prompt
DESIRED_RETENTION=0.9
